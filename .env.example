# Copia questo file in ".env.local" e riempi i valori.
# NON condividere le chiavi segrete.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la_tua_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=la_tua_service_role_key

# Email di chi può vedere la dashboard admin (separa più email con la virgola)
ADMIN_EMAILS=cristiano@esempio.it

# URL pubblico dell'app (in locale: http://localhost:3000; in produzione: https://rateradar.pro)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (dashboard.stripe.com -> Developers) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID dei due piani creati in Stripe (Products -> Add product)
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRO=price_...
